# Create these credentials in OKX Demo Trading.
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=

# Create a separate production key only when you are ready for real trading.
OKX_LIVE_API_KEY=
OKX_LIVE_SECRET_KEY=
OKX_LIVE_PASSPHRASE=

# Dubai/global accounts normally use https://openapi.okx.com.
# Regional accounts may require https://us.okx.com or https://eea.okx.com.
OKX_BASE_URL=https://openapi.okx.com

# Live orders remain blocked even when --env live is selected.
OKX_LIVE_TRADING=false
OKX_REQUEST_TIMEOUT_MS=10000
